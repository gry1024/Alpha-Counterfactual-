LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# AlphaPROBE (train_new_work.py) uses OPENAI_* names; can share the same key/url/model.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_NAME=

QLIB_PATH_CN=data/qlib_data/cn_data_rolling
QLIB_PATH_SP500=data/qlib_data/us_data_qlib_latest

# Optional: sentence-transformers embedding model for AlphaPROBE retrieval
# Official paper uses Qwen/Qwen3-Embedding-4B (~8GB GPU). RTX 4060 8GB should use 0.6B:
# EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B

# 可选
# LLM_TEMPERATURE=0.4
# LLM_MAX_TOKENS=65536
# MiniMax-M3: thinking=adaptive + reasoning_split so CoT is not in content.
# LLM_THINKING=adaptive
# LLM_THINKING=disabled
# LLM_TIMEOUT=600
# retry network / 429 / 5xx for this many seconds (default 300)
# LLM_RETRY_BUDGET=300

# 常见取值:
#   MiniMax   LLM_BASE_URL=https://api.minimaxi.com/v1                         LLM_MODEL=MiniMax-M3
#   deepseek  LLM_BASE_URL=https://api.deepseek.com                            LLM_MODEL=deepseek-chat
#   qwen      LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
#   openai    LLM_BASE_URL=https://api.openai.com/v1                           LLM_MODEL=gpt-4o-mini