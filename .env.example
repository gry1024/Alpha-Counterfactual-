# OpenAI 兼容协议的 LLM 配置(run_cf_pipeline / LLMProposer 读取)
# 三个都可在命令行临时覆盖:--llm_model / --llm_base_url
LLM_API_KEY=
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_MODEL=MiniMax-M3

# 常见取值:
#   deepseek:  LLM_BASE_URL=https://api.deepseek.com                    LLM_MODEL=deepseek-chat
#   qwen:      LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
#   openai:    LLM_BASE_URL=https://api.openai.com/v1                   LLM_MODEL=gpt-4o-mini
#   claude:    LLM_BASE_URL=https://api.anthropic.com/v1                LLM_MODEL=claude-sonnet-4-5
